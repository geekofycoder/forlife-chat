# Template only. Copy to .env for local use; on the host, type these into its Environment settings.
# Never put real values in this file, in git, or in chat.

# Supabase: Dashboard > Connect > "Session pooler" connection string, with your database password filled in
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres

# Anthropic Console > Settings > API keys
ANTHROPIC_API_KEY=

# Only if the key is not tied to one workspace (Console > Settings > Workspaces > ID column)
ANTHROPIC_WORKSPACE_ID=

# The one password you share with testers
SHARED_PASSWORD=

# Optional
# CHAT_MODEL=claude-sonnet-5-5
# CHAT_EFFORT=low
# INTERVIEW_EFFORT=low
